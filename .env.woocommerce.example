# Configuración de WooCommerce
# Agrega estas variables a tu archivo .env para habilitar la integración con WooCommerce

# URL de tu tienda WooCommerce (sin barra final)
WOOCOMMERCE_URL=https://tu-tienda.com

# Consumer Key de la API de WooCommerce
# Se obtiene en: WooCommerce > Configuración > API > Claves
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Consumer Secret de la API de WooCommerce  
# Se obtiene en: WooCommerce > Configuración > API > Claves
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Versión de la API de WooCommerce (opcional, por defecto wc/v3)
WOOCOMMERCE_VERSION=wc/v3

# === CONFIGURACIÓN DE SUCURSALES ===

# Directorio donde se encuentran los archivos JSON de sucursales
SUCURSALES_DIR=./examples/yaguar precioswebfull

# Archivo por defecto para parsear (archivo principal de sucursal)
SUCURSALES_DEFAULT_FILE=./examples/yaguar precioswebfull/webprecautopista.json

# Auto-subida a WooCommerce al parsear (true/false)
AUTO_UPLOAD_WOOCOMMERCE=true

# Tamaño de lote para subida a WooCommerce (productos por lote)
WOOCOMMERCE_BATCH_SIZE=10
